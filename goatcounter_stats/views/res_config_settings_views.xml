<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.goatcounter_stats</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Website Stats" string="Website Stats" name="goatcounter_stats"
                     logo="/goatcounter_stats/static/description/icon.png" groups="base.group_system">
                    <block title="GoatCounter" name="goatcounter_setting_container">
                        <setting id="goatcounter_site" string="Site"
                                 help="Statistics come from https://&lt;code&gt;.goatcounter.com. The API key is read from the GOAT_COUNTER_KEY environment variable and is never stored in the database.">
                            <div class="content-group mt-2">
                                <div class="row">
                                    <label for="goatcounter_site_code" class="col-lg-4 o_light_label"/>
                                    <field name="goatcounter_site_code" placeholder="yaserakhras"/>
                                </div>
                                <div class="row">
                                    <label for="goatcounter_key_found" class="col-lg-4 o_light_label"/>
                                    <field name="goatcounter_key_found"/>
                                </div>
                            </div>
                        </setting>
                        <setting id="goatcounter_sync" string="Synchronisation"
                                 help="Runs every hour for today and yesterday.">
                            <div class="content-group mt-2">
                                <div class="row">
                                    <label for="goatcounter_last_sync" class="col-lg-4 o_light_label"/>
                                    <field name="goatcounter_last_sync"/>
                                </div>
                                <div class="row">
                                    <label for="goatcounter_last_result" class="col-lg-4 o_light_label"/>
                                    <field name="goatcounter_last_result"/>
                                </div>
                                <div class="row">
                                    <label for="goatcounter_visit_result" class="col-lg-4 o_light_label"/>
                                    <field name="goatcounter_visit_result"/>
                                </div>
                                <div class="row mt-2">
                                    <label for="goatcounter_backfill_from" class="col-lg-4 o_light_label"/>
                                    <field name="goatcounter_backfill_from"/>
                                </div>
                                <div class="mt-2">
                                    <button name="action_goatcounter_sync_now" type="object" string="Sync now"
                                            icon="fa-refresh" class="btn-link"/>
                                    <button name="action_goatcounter_backfill" type="object" string="Backfill"
                                            icon="fa-history" class="btn-link"/>
                                </div>
                            </div>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

    <record id="goatcounter_config_action" model="ir.actions.act_window">
        <field name="name">Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="context">{'module': 'goatcounter_stats', 'bin_size': False}</field>
    </record>
</odoo>
