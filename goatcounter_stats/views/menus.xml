<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="goatcounter_dashboard_action" model="ir.actions.client">
        <field name="name">Website Stats</field>
        <field name="tag">goatcounter_stats.dashboard</field>
    </record>

    <menuitem id="menu_goatcounter_root" name="Website Stats" sequence="90" action="goatcounter_dashboard_action"
              web_icon="goatcounter_stats,static/description/icon.png" groups="base.group_system"/>
    <menuitem id="menu_goatcounter_dashboard" name="Dashboard" parent="menu_goatcounter_root"
              action="goatcounter_dashboard_action" sequence="1"/>
    <menuitem id="menu_goatcounter_total" name="Visits" parent="menu_goatcounter_root"
              action="goatcounter_total_action" sequence="10"/>
    <menuitem id="menu_goatcounter_pages" name="Pages" parent="menu_goatcounter_root"
              action="goatcounter_hit_page_action" sequence="20"/>
    <menuitem id="menu_goatcounter_clicks" name="Clicks" parent="menu_goatcounter_root"
              action="goatcounter_hit_event_action" sequence="30"/>
    <menuitem id="menu_goatcounter_journeys" name="Visitor journeys" parent="menu_goatcounter_root"
              action="goatcounter_visit_action" sequence="35"/>
    <menuitem id="menu_goatcounter_sources" name="Sources" parent="menu_goatcounter_root"
              action="goatcounter_dimension_action" sequence="40"/>
    <menuitem id="menu_goatcounter_config" name="Settings" parent="menu_goatcounter_root"
              action="goatcounter_config_action" sequence="90"/>
</odoo>
