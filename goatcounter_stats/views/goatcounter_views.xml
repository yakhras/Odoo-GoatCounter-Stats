<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Overview: visits per day -->
    <record id="goatcounter_total_view_list" model="ir.ui.view">
        <field name="name">goatcounter.total.list</field>
        <field name="model">goatcounter.total</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="date"/>
                <field name="count" sum="Total"/>
            </list>
        </field>
    </record>

    <record id="goatcounter_total_view_graph" model="ir.ui.view">
        <field name="name">goatcounter.total.graph</field>
        <field name="model">goatcounter.total</field>
        <field name="arch" type="xml">
            <graph type="line" sample="1">
                <field name="date" interval="day"/>
                <field name="count" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="goatcounter_total_view_pivot" model="ir.ui.view">
        <field name="name">goatcounter.total.pivot</field>
        <field name="model">goatcounter.total</field>
        <field name="arch" type="xml">
            <pivot>
                <field name="date" interval="week" type="row"/>
                <field name="count" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="goatcounter_total_view_search" model="ir.ui.view">
        <field name="name">goatcounter.total.search</field>
        <field name="model">goatcounter.total</field>
        <field name="arch" type="xml">
            <search>
                <filter name="filter_date" string="Date" date="date"/>
                <group>
                    <filter name="group_date" string="Date" context="{'group_by': 'date'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="goatcounter_total_action" model="ir.actions.act_window">
        <field name="name">Visits</field>
        <field name="res_model">goatcounter.total</field>
        <field name="view_mode">graph,pivot,list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No stats yet</p>
            <p>Run "Sync now" or "Backfill" in Settings → Website Stats.</p>
        </field>
    </record>

    <!-- Pages and click events -->
    <record id="goatcounter_hit_view_list" model="ir.ui.view">
        <field name="name">goatcounter.hit.list</field>
        <field name="model">goatcounter.hit</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="date"/>
                <field name="path"/>
                <field name="title" optional="show"/>
                <field name="is_event" optional="hide"/>
                <field name="count" sum="Total"/>
            </list>
        </field>
    </record>

    <record id="goatcounter_hit_view_graph" model="ir.ui.view">
        <field name="name">goatcounter.hit.graph</field>
        <field name="model">goatcounter.hit</field>
        <field name="arch" type="xml">
            <graph type="bar" sample="1">
                <field name="path"/>
                <field name="count" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="goatcounter_hit_view_pivot" model="ir.ui.view">
        <field name="name">goatcounter.hit.pivot</field>
        <field name="model">goatcounter.hit</field>
        <field name="arch" type="xml">
            <pivot>
                <field name="path" type="row"/>
                <field name="date" interval="week" type="col"/>
                <field name="count" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="goatcounter_hit_view_search" model="ir.ui.view">
        <field name="name">goatcounter.hit.search</field>
        <field name="model">goatcounter.hit</field>
        <field name="arch" type="xml">
            <search>
                <field name="path"/>
                <field name="title"/>
                <filter name="filter_date" string="Date" date="date"/>
                <group>
                    <filter name="group_path" string="Page / event" context="{'group_by': 'path'}"/>
                    <filter name="group_date" string="Date" context="{'group_by': 'date'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="goatcounter_hit_page_action" model="ir.actions.act_window">
        <field name="name">Pages</field>
        <field name="res_model">goatcounter.hit</field>
        <field name="view_mode">graph,pivot,list</field>
        <field name="domain">[('is_event', '=', False)]</field>
    </record>

    <record id="goatcounter_hit_event_action" model="ir.actions.act_window">
        <field name="name">Clicks</field>
        <field name="res_model">goatcounter.hit</field>
        <field name="view_mode">graph,pivot,list</field>
        <field name="domain">[('is_event', '=', True)]</field>
    </record>

    <!-- Sources: referrers, countries, browsers, systems, screen sizes -->
    <record id="goatcounter_dimension_view_list" model="ir.ui.view">
        <field name="name">goatcounter.dimension.list</field>
        <field name="model">goatcounter.dimension</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="date"/>
                <field name="kind"/>
                <field name="name"/>
                <field name="count" sum="Total"/>
            </list>
        </field>
    </record>

    <record id="goatcounter_dimension_view_graph" model="ir.ui.view">
        <field name="name">goatcounter.dimension.graph</field>
        <field name="model">goatcounter.dimension</field>
        <field name="arch" type="xml">
            <graph type="pie" sample="1">
                <field name="name"/>
                <field name="count" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="goatcounter_dimension_view_pivot" model="ir.ui.view">
        <field name="name">goatcounter.dimension.pivot</field>
        <field name="model">goatcounter.dimension</field>
        <field name="arch" type="xml">
            <pivot>
                <field name="kind" type="row"/>
                <field name="name" type="row"/>
                <field name="count" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="goatcounter_dimension_view_search" model="ir.ui.view">
        <field name="name">goatcounter.dimension.search</field>
        <field name="model">goatcounter.dimension</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <filter name="kind_toprefs" string="Referrers" domain="[('kind', '=', 'toprefs')]"/>
                <filter name="kind_locations" string="Countries" domain="[('kind', '=', 'locations')]"/>
                <filter name="kind_browsers" string="Browsers" domain="[('kind', '=', 'browsers')]"/>
                <filter name="kind_systems" string="Systems" domain="[('kind', '=', 'systems')]"/>
                <filter name="kind_sizes" string="Screen sizes" domain="[('kind', '=', 'sizes')]"/>
                <separator/>
                <filter name="filter_date" string="Date" date="date"/>
                <group>
                    <filter name="group_kind" string="Type" context="{'group_by': 'kind'}"/>
                    <filter name="group_name" string="Value" context="{'group_by': 'name'}"/>
                    <filter name="group_date" string="Date" context="{'group_by': 'date'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="goatcounter_dimension_action" model="ir.actions.act_window">
        <field name="name">Sources</field>
        <field name="res_model">goatcounter.dimension</field>
        <field name="view_mode">pivot,graph,list</field>
        <field name="context">{'search_default_kind_locations': 1}</field>
    </record>
</odoo>
